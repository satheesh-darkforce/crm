{
    "name": "maestro/erp",
    "description": "Maestro ERP — Yii 2 Application",
    "keywords": ["yii2", "erp"],
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1.0",
        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "yiisoft/yii2-symfonymailer": "~2.0.3",
        "phpoffice/phpspreadsheet": "^2.1",
        "yiisoft/yii2-httpclient": "*",
        "yiisoft/yii2-authclient": "~2.2.0",
        "kartik-v/yii2-widget-select2": "^2.2",
        "kartik-v/yii2-datecontrol": "^1.9",
        "kartik-v/yii2-widget-datepicker": "@dev",
        "twbs/bootstrap-icons": "^1.13",
        "mpdf/mpdf": "^8.3",
        "setasign/fpdf": "^1.8",
        "kartik-v/yii2-widget-timepicker": "^1.0"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0"
    },
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "backend\\": "backend/",
            "console\\": "console/",
            "api\\": "api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "common\\tests\\": ["common/tests/", "common/tests/_support"],
            "backend\\tests\\": ["backend/tests/", "backend/tests/_support"]
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
