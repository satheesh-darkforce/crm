# ─── Dependencies ─────────────────────────────────────────────
/vendor/
node_modules/
composer.phar
phpunit.phar

# ─── Environment-specific config (generated by `php init`) ────
# Real credentials live in *-local.php; templates are in /environments.
*-local.php
!/environments/**/*-local.php
.env
.env.*
!.env.example

# ─── Credentials & keys — never commit ────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk
auth.json
credentials*.json
secrets*.php
*.secret

# Yii console entry scripts (generated by `php init`)
/yii
/yii_test
/yii_test.bat

# Generated web entry scripts (generated by `php init`)
/backend/web/index.php
/backend/web/index-test.php
/backend/web/robots.txt
/api/web/index.php
/api/web/index-test.php

# ─── Runtime / generated files ────────────────────────────────
/backend/runtime/*
/console/runtime/*
/api/runtime/*
/common/runtime/*
!/*/runtime/.gitignore

/backend/web/assets/*
/api/web/assets/*
!/*/web/assets/.gitignore

# Test output
/*/tests/_output/*
!/*/tests/_output/.gitignore
/phpunit.xml

# ─── User-uploaded files (data, not code) ─────────────────────
uploads/

# ─── Logs, dumps, caches ──────────────────────────────────────
*.log
*.cache
.phpunit.result.cache
*.sql.gz
*.sql.zip

# ─── Vagrant / Docker runtime ─────────────────────────────────
/.vagrant
/vagrant/nginx/log/*
!/vagrant/nginx/log/.gitignore

# ─── IDE / editor ─────────────────────────────────────────────
.idea/
.vscode/
nbproject/
.buildpath
.project
.settings/
*.swp
*~

# Claude Code local settings
.claude/settings.local.json

# ─── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
